# First choice: Claude (Anthropic API). Takes precedence over both providers
# below; any Claude failure hands the call to them. Leave the key empty to turn
# Claude off. The key must be assigned to a workspace (an unscoped key 400s).
ANTHROPIC_API_KEY=
# Ranked: the first is used, the next when it is overloaded or retired.
CLAUDE_MODELS=claude-sonnet-5-5,claude-haiku-5-5
CLAUDE_EFFORT=low

# Primary provider: OpenRouter (still has free models). Drop this key and the
# app falls back to Cerebras-only operation.
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Fallback provider: Cerebras pay-as-you-go. Its always-free tier was retired in
# July 2026 (an expired trial returns HTTP 402 payment_required), so
# CEREBRAS_API_KEY is normally left empty and the paid key is used.
CEREBRAS_API_KEY=
CEREBRAS_PAID_API_KEY=your-cerebras-paid-key-here
MODEL=gpt-oss-120b
LLM_BASE_URL=https://api.cerebras.ai/v1

# Optional: path to a prebuilt DuckDB artifact
# (python data_model.py --materialize data/lou.duckdb).
# Set -> startup opens that file read-only (~0.5s, ~400MB RSS).
# Unset -> startup rebuilds from the CSVs in DATA_DIR (~5s, ~1.9GB RSS).
# A missing file here fails at boot deliberately; it does not fall back.
PREBUILT_DB=
